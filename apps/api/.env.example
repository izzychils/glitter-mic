# Glitter Mic API - copy to .env for local dev (both files are gitignored).
# In production these same keys go in Render -> your service -> Environment.
# Never commit real values; this tracked file is only the template.

NODE_ENV=development
# Local dev only. Render injects PORT automatically - do not set it there.
PORT=4000
# Frontend origin: http://localhost:5173 locally, your Vercel URL in production.
CLIENT_ORIGIN=http://localhost:5173

# --- Phase 2: Google Identity Services ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:5173 (add your Vercel domain later).
# Must be the same value as VITE_GOOGLE_CLIENT_ID in apps/web.
GOOGLE_CLIENT_ID=
# Generate this yourself (nobody issues it), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Phase 7: persistence + leaderboards ---
# Neon Postgres: use the pooled connection string (postgresql://...?sslmode=require).
# Neon dashboard -> your project -> Connect -> Pooled connection.
# NOTE: confirmed decision - Neon instead of the build guide's MongoDB.
DATABASE_URL=
# Upstash Redis connection string (rediss://...) for leaderboard sorted sets + job queue.
# Upstash console -> create database -> copy the connection string.
REDIS_URL=

# --- Phase 6: streaming speech-to-text ---
# Deepgram console -> API Keys -> create key.
DEEPGRAM_API_KEY=

# --- Phase 3: royalty-free song catalog ---
# Jamendo developer portal -> register an app -> Client ID.
JAMENDO_ID=
