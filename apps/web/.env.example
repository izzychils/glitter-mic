# Glitter Mic web - copy to .env for local dev.
# In production set these in Vercel -> Project -> Settings -> Environment Variables.
# Only VITE_* values reach the browser, so never put secrets in this file.

# API base URL: http://localhost:4000 locally, your Render service URL in production
# (for example https://glitter-mic-api.onrender.com).
VITE_API_URL=http://localhost:4000

# --- Phase 2: Google Identity Services ---
# Same client id as the API's GOOGLE_CLIENT_ID. Client ids are public by design,
# so this one is safe to ship in the bundle.
VITE_GOOGLE_CLIENT_ID=
